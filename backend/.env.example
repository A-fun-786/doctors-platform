APP_NAME=Doctor Platform API
ENVIRONMENT=development
# Database Configuration (PostgreSQL Required for Production)
# Standard connection string format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
# Uses psycopg (v3) as the high-performance PostgreSQL driver.
# In production, use a managed database (Supabase, Neon, AWS RDS, GCP Cloud SQL).
# Run schema migrations via Alembic: `alembic upgrade head`
# Local development can use PostgreSQL or fallback to SQLite: `sqlite:///./doctor_platform.db`
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/doctor_platform
CORS_ORIGINS=http://localhost:3000


# Auth Configuration
# Set ALLOW_MOCK_AUTH=true only for local development/testing without real Google credentials. Never in production.
ALLOW_MOCK_AUTH=false
GOOGLE_CLIENT_ID=
JWT_SECRET_KEY=replace-with-secure-secret-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──── Rate Limiting (SlowAPI) ────
# Global per-IP rate limit applied across all endpoints
RATE_LIMIT_GLOBAL=100/minute
# Brute-force protection for sensitive auth endpoints
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_AUTH_GOOGLE=10/minute

# ──── Observability & Crash Reporting (Sentry & Structlog) ────
# Sentry DSN for centralized crash reporting and APM. Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: "json" for structured production logs, "console" for dev
LOG_FORMAT=console


{
  "name": "doctor-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/test_appointments_comprehensive.mjs && node scripts/test_calendar_utils.mjs",
    "test:calendar": "node scripts/test_calendar_utils.mjs",
    "test:shell": "node scripts/test_dashboard_shell.mjs",
    "test:live": "node scripts/verify_phase7_live.mjs",
    "test:e2e": "node scripts/e2e_full_verification.mjs",
    "test:qa": "node scripts/test_full_platform_qa.mjs",
    "test:all": "npm run test:shell && npm run test && npm run test:e2e && npm run test:live && npm run test:qa",
    "servers:start": "./scripts/start-servers.sh",
    "servers:start:bg": "./scripts/start-servers.sh --background",
    "servers:start:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/start-servers.ps1",
    "servers:stop": "./scripts/stop-servers.sh",
    "servers:stop:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-servers.ps1",
    "servers:restart": "./scripts/stop-servers.sh && ./scripts/start-servers.sh",
    "servers:logs": "tail -f logs/backend.log logs/frontend.log",
    "tunnel": "npx localtunnel --port 3000 --local-host 127.0.0.1",
    "tunnel:pinggy": "./scripts/start-tunnel.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.24",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}

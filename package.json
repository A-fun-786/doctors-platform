{
  "name": "doctor-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:calendar:all && npm run test:onboarding",
    "test:onboarding": "node scripts/tests/onboarding/test_onboarding_hardening.mjs",
    "test:calendar": "node scripts/tests/calendar/test_calendar_utils.mjs",
    "test:calendar:sidebar": "node scripts/tests/calendar/test_calendar_sidebar_theme.mjs",
    "test:calendar:no-demo": "node scripts/tests/calendar/test_calendar_no_demo_fallback.mjs",
    "test:calendar:all": "node scripts/tests/calendar/test_calendar_utils.mjs && node scripts/tests/calendar/test_calendar_no_demo_fallback.mjs && node scripts/tests/calendar/test_calendar_sidebar_theme.mjs",
    "test:e2e": "node scripts/tests/e2e/e2e_full_verification.mjs",
    "servers:start": "./scripts/start-servers.sh",
    "servers:start:bg": "./scripts/start-servers.sh --background",
    "servers:start:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/start-servers.ps1",
    "servers:stop": "./scripts/stop-servers.sh",
    "servers:stop:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-servers.ps1",
    "servers:restart": "./scripts/stop-servers.sh && ./scripts/start-servers.sh",
    "servers:logs": "tail -f logs/backend.log logs/frontend.log",
    "tunnel": "npx localtunnel --port 3000 --local-host 127.0.0.1",
    "tunnel:pinggy": "./scripts/start-tunnel.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.24",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
